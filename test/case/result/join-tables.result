INVALID RELATIONS FIELDS AMBIGUITY AND ON SCOPES FAIL
select jt_left.id from jt_left inner join jt_missing on jt_left.id = jt_missing.id;
FAILURE
select jt_left.id from jt_left inner join jt_right on jt_left.missing = jt_right.id;
FAILURE
select jt_left.id from jt_left inner join jt_right on id = jt_right.id;
FAILURE
select id from jt_left inner join jt_right on jt_left.id = jt_right.id;
FAILURE
select jt_left.id from jt_left inner join jt_right on jt_third.id = jt_right.id;
FAILURE
select jt_left.id from jt_left inner join jt_right on jt_left.id = jt_third.id inner join jt_third on jt_right.id = jt_third.id;
FAILURE
select jt_left.id from jt_left, jt_right inner join jt_third on jt_left.id = jt_right.id;
FAILURE
select jt_left.id from jt_left inner join jt_right on jt_left.born = '1900-02-29';
FAILURE

INDEXES PRESERVE DUPLICATE AND CHAINED JOIN RESULTS
create index jt_left_id on jt_left(id);
SUCCESS
create index jt_right_id on jt_right(id);
SUCCESS
select jt_left.tag, jt_right.label from jt_left inner join jt_right on jt_left.id = jt_right.id and jt_right.score > 1.5 where jt_left.id = 1;
ONE | TWO
TAG | LABEL
TWO | TWO
select jt_left.tag, jt_right.label, jt_third.grp from jt_left inner join jt_right on jt_left.id = jt_right.id inner join jt_third on jt_right.id = jt_third.id where jt_third.id = 1;
ONE | ONE | 2
ONE | TWO | 2
TAG | LABEL | GRP
TWO | ONE | 2
TWO | TWO | 2

QUALIFIED WILDCARD AND FALSE CONDITIONS AFTER ROW PREDICATES
select jt_left.* from jt_left inner join jt_right on jt_left.id = jt_right.id where jt_left.id = 2;
ID | GRP | BORN | TAG
2 | 2 | 2038-02-01 | TWO
select jt_left.id from jt_left inner join jt_right on jt_left.id = jt_right.id and 1 = 0 where jt_left.grp = 2;
ID
select jt_left.id from jt_left inner join jt_right on jt_left.id = jt_right.id where jt_left.grp = 2 and 1 = 0;
ID

JOINS FALL BACK CORRECTLY AFTER ACTIVATING CHUNK AND CASCADE MODES
set execution_mode='chunk_iterator';
SUCCESS
select jt_left.id from jt_left where 1 = 0;
ID
set use_cascade=1;
SUCCESS
select jt_left.id from jt_left inner join jt_right on jt_left.id = jt_right.id where jt_left.id = 2;
ID
2
select jt_left.id from jt_left inner join jt_right on 1 = 0;
ID
set use_cascade=0;
SUCCESS
set execution_mode='tuple_iterator';
SUCCESS
