ID
select jt_left.id from jt_left inner join jt_empty on jt_left.id = jt_empty.id inner join jt_third on jt_empty.id = jt_third.id;
ID
select jt_left.id from jt_left inner join jt_right on jt_left.id = jt_right.id inner join jt_empty on jt_right.id = jt_empty.id;
ID

