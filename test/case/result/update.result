EMPTY TABLES STILL VALIDATE ASSIGNMENTS AND PREDICATES
create table update_case(id int, grp int, score float, label char(16), born date);
SUCCESS
update update_case set id = 1;
SUCCESS
update update_missing set id = 1;
FAILURE
update update_case set missing = 1;
FAILURE
update update_case set id = 1 where missing = 1;
FAILURE
update update_case set id = 'bad';
FAILURE
update update_case set score = 'bad';
FAILURE
update update_case set label = 1;
FAILURE
update update_case set born = 20000101;
FAILURE
update update_case set born = '1900-2-29';
FAILURE
update update_case set born = '2000-2-30' where id = 99;
FAILURE
update update_case set score = 2 where born = '2100-2-29';
FAILURE
update update_case set score = 2 where '2100-2-29' < born;
FAILURE
select * from update_case;
ID | GRP | SCORE | LABEL | BORN

SINGLE COLUMN CHANGES PRESERVE EVERY OTHER FIELD
insert into update_case values(1, 1, 1.25, 'long-old-label', '1969-12-31');
SUCCESS
insert into update_case values(2, 1, 2.5, 'beta', '2000-2-29');
SUCCESS
insert into update_case values(3, 2, 3.75, 'gamma', '2038-2-1');
SUCCESS
insert into update_case values(4, 3, 4.5, 'delta', '2400-2-29');
SUCCESS
update update_case set label = 'z' where id = 1;
SUCCESS
select * from update_case;
1 | 1 | 1.25 | Z | 1969-12-31
2 | 1 | 2.5 | BETA | 2000-02-29
3 | 2 | 3.75 | GAMMA | 2038-02-01
4 | 3 | 4.5 | DELTA | 2400-02-29
ID | GRP | SCORE | LABEL | BORN
select id from update_case where label = 'long-old-label';
ID
select label from update_case where id = 1;
LABEL
Z
update update_case set label = '2020-1-1' where id = 2;
SUCCESS
update update_case set grp = 9;
SUCCESS
update update_case set score = 7 where grp = 9 and id <= 2;
SUCCESS
update update_case set id = -5 where id = 3;
SUCCESS
update update_case set score = -6.25 where id = 4;
SUCCESS
update update_case set born = '1900-2-28' where id = -5;
SUCCESS
update update_case set born = '2400-2-29' where id = 4;
SUCCESS
select * from update_case;
-5 | 9 | 3.75 | GAMMA | 1900-02-28
1 | 9 | 7 | Z | 1969-12-31
2 | 9 | 7 | 2020-1-1 | 2000-02-29
4 | 9 | -6.25 | DELTA | 2400-02-29
ID | GRP | SCORE | LABEL | BORN

INVALID UPDATES LEAVE ALL POPULATED ROWS UNCHANGED
update update_case set born = '2100-2-29' where id = 1;
FAILURE
update update_case set id = 'bad' where id = 1;
FAILURE
update update_case set grp = 2 where born = '1900-2-29';
FAILURE
update update_case set grp = 2 where missing = 9;
FAILURE
update update_case set id = 100 where id = 99;
SUCCESS
select * from update_case;
-5 | 9 | 3.75 | GAMMA | 1900-02-28
1 | 9 | 7 | Z | 1969-12-31
2 | 9 | 7 | 2020-1-1 | 2000-02-29
4 | 9 | -6.25 | DELTA | 2400-02-29
ID | GRP | SCORE | LABEL | BORN

MOVING AN INDEXED SCAN KEY UPDATES DUPLICATE ROWS EXACTLY ONCE
create index update_case_id on update_case(id);
SUCCESS
create index update_case_grp on update_case(grp);
SUCCESS
create index update_case_score on update_case(score);
SUCCESS
create index update_case_label on update_case(label);
SUCCESS
create index update_case_born on update_case(born);
SUCCESS
update update_case set id = 5 where id < 10;
SUCCESS
