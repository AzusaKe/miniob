VECTOR DIMENSIONS AND TABLE CREATION
CREATE TABLE VB_BAD(V VECTOR(0));
FAILURE
CREATE TABLE VB_BAD(V VECTOR(-1));
SQL_SYNTAX > FAILED TO PARSE SQL
CREATE TABLE VB_BAD(V VECTOR(16384));
FAILURE
CREATE TABLE VB_BAD(V VECTOR(4294967299));
FAILURE
CREATE TABLE VB_BAD(V VECTOR());
SQL_SYNTAX > FAILED TO PARSE SQL
CREATE TABLE VB_BAD(V VECTOR(3), PRIMARY KEY(V));
FAILURE
CREATE TABLE VB_DEFAULT(V VECTOR);
SUCCESS
INSERT INTO VB_DEFAULT VALUES(STRING_TO_VECTOR('[1,2,3]'));
SUCCESS
SELECT VECTOR_TO_STRING(V) AS DEFAULT_VEC FROM VB_DEFAULT;
DEFAULT_VEC
[1.00000E+00,2.00000E+00,3.00000E+00]
DROP TABLE VB_DEFAULT;
SUCCESS
CREATE TABLE VB_MAX(V VECTOR(16383));
SUCCESS
DROP TABLE VB_MAX;
SUCCESS
CREATE TABLE VB_CAPACITY(ID INT, V VECTOR(3));
SUCCESS
INSERT INTO VB_CAPACITY VALUES(1, STRING_TO_VECTOR('[1,2]'));
SUCCESS
INSERT INTO VB_CAPACITY VALUES(2, STRING_TO_VECTOR('[3]'));
SUCCESS
SELECT ID, VECTOR_TO_STRING(V) AS ACTUAL_SIZE FROM VB_CAPACITY;
1 | [1.00000E+00,2.00000E+00]
2 | [3.00000E+00]
ID | ACTUAL_SIZE
UPDATE VB_CAPACITY SET V = STRING_TO_VECTOR('[9]') WHERE ID = 1;
SUCCESS
SELECT ID, VECTOR_TO_STRING(V) AS RESIZED FROM VB_CAPACITY;
1 | [9.00000E+00]
2 | [3.00000E+00]
ID | RESIZED
UPDATE VB_CAPACITY SET V = STRING_TO_VECTOR('[1,2,3,4]') WHERE ID = 1;
FAILURE
SELECT VECTOR_TO_STRING(V) AS UNCHANGED FROM VB_CAPACITY WHERE ID = 1;
UNCHANGED
[9.00000E+00]
DROP TABLE VB_CAPACITY;
SUCCESS
CREATE TABLE VB(ID INT, V1 VECTOR(3), V2 VECTOR(3), METRIC CHAR(16), LABEL CHAR(16));
SUCCESS
INSERT INTO VB VALUES(1, STRING_TO_VECTOR('[1, 2, 3]'), STRING_TO_VECTOR('[4,6,3]'), 'EUCLIDEAN', 'FIRST');
SUCCESS
INSERT INTO VB VALUES(2, STRING_TO_VECTOR(' [ -1E0, +0.0, 1. ] '), STRING_TO_VECTOR('[1,0,-1]'), 'DOT', 'SECOND');
SUCCESS
INSERT INTO VB VALUES(3, STRING_TO_VECTOR('[0,0,0]'), STRING_TO_VECTOR('[0,0,0]'), 'EUCLIDEAN', 'ZERO');
SUCCESS

CONVERSION FUNCTIONS ALIASES AND CONSTANT SELECTS
SELECT VECTOR_TO_STRING(STRING_TO_VECTOR('[1,-2.5,0.125,0]')) AS FORMATTED;
FORMATTED
[1.00000E+00,-2.50000E+00,1.25000E-01,0.00000E+00]
SELECT FROM_VECTOR(TO_VECTOR('[1, 2, 3]')) AS SYNONYM;
SYNONYM
[1.00000E+00,2.00000E+00,3.00000E+00]
SELECT VECTOR_TO_STRING(STRING_TO_VECTOR(VECTOR_TO_STRING(STRING_TO_VECTOR('[1.25, -0.5, 100]')))) AS ROUND_TRIP;
ROUND_TRIP
[1.25000E+00,-5.00000E-01,1.00000E+02]
SELECT DISTANCE(STRING_TO_VECTOR('[1,2,3]'), STRING_TO_VECTOR('[4,6,3]'), 'EUCLIDEAN') AS EUCLIDEAN;
EUCLIDEAN
5
SELECT DISTANCE(STRING_TO_VECTOR('[1,2,3]'), STRING_TO_VECTOR('[4,-2,1]'), 'DOT') AS DOT_PRODUCT;
DOT_PRODUCT
3
SELECT DISTANCE(STRING_TO_VECTOR('[1,0]'), STRING_TO_VECTOR('[0,1]'), 'COSINE') AS COSINE;
COSINE
1
SELECT DISTANCE(STRING_TO_VECTOR('[1,0]'), STRING_TO_VECTOR('[-1,0]'), 'COSINE') AS OPPOSITE;
OPPOSITE
2
SELECT VECTOR_DISTANCE(TO_VECTOR('[3,4]'), TO_VECTOR('[6,8]'), 'COSINE') AS PARALLEL;
PARALLEL
0
SELECT 2 + DISTANCE(STRING_TO_VECTOR('[3,4]'), STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') AS ARITHMETIC;
ARITHMETIC
7
SELECT VECTOR_TO_STRING(STRING_TO_VECTOR('[.5,2.,+1E2]')) AS DECIMALS;
DECIMALS
[5.00000E-01,2.00000E+00,1.00000E+02]

COLUMN CONVERSION MULTIPLE VECTORS AND ALL DISTANCE METHODS
SELECT ID, VECTOR_TO_STRING(V1) AS FIRST_VEC, VECTOR_TO_STRING(V2) AS SECOND_VEC, LABEL FROM VB;
1 | [1.00000E+00,2.00000E+00,3.00000E+00] | [4.00000E+00,6.00000E+00,3.00000E+00] | FIRST
2 | [-1.00000E+00,0.00000E+00,1.00000E+00] | [1.00000E+00,0.00000E+00,-1.00000E+00] | SECOND
3 | [0.00000E+00,0.00000E+00,0.00000E+00] | [0.00000E+00,0.00000E+00,0.00000E+00] | ZERO
ID | FIRST_VEC | SECOND_VEC | LABEL
SELECT ID, DISTANCE(V1, V2, 'EUCLIDEAN') AS EUCLIDEAN, DISTANCE(V1, V2, 'DOT') AS DOT_PRODUCT FROM VB;
1 | 5 | 25
2 | 2.83 | -2
3 | 0 | 0
ID | EUCLIDEAN | DOT_PRODUCT
SELECT DISTANCE(V1, STRING_TO_VECTOR('[1,2,3]'), 'COSINE') AS SAME_DIRECTION FROM VB WHERE ID = 1;
SAME_DIRECTION
0
SELECT -DISTANCE(V1, V2, 'DOT') AS NEG FROM VB WHERE ID = 1;
NEG
-25
SELECT ID, DISTANCE(V1, V2, METRIC) AS CHOSEN_DISTANCE FROM VB;
1 | 5
2 | -2
3 | 0
ID | CHOSEN_DISTANCE
SELECT VECTOR_TO_STRING(STRING_TO_VECTOR(LABEL)) AS PARSED_TEXT FROM VB WHERE ID = 99;
PARSED_TEXT
SELECT ID FROM VB WHERE V1 = V1;
1
2
3
ID
SELECT ID FROM VB WHERE V1 = V2;
ID
3
SELECT ID FROM VB WHERE V1 = STRING_TO_VECTOR('[1,2,3]');
ID
1
SELECT ID FROM VB WHERE STRING_TO_VECTOR('[-1,0,1]') = V1;
ID
2

