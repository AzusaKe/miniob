VECTOR QUERIES USE TUPLE FALLBACK WHEN CHUNK EXECUTION IS REQUESTED
SET EXECUTION_MODE='CHUNK_ITERATOR';
SUCCESS
SELECT ID, DISTANCE(V2, STRING_TO_VECTOR('[0,0,0]'), 'EUCLIDEAN') AS LENGTH FROM VB;
1 | 5
2 | 5
ID | LENGTH
SET EXECUTION_MODE='TUPLE_ITERATOR';
SUCCESS
SET USE_CASCADE=1;
SUCCESS
SELECT VECTOR_TO_STRING(V2) AS STORED FROM VB WHERE ID = 2;
STORED
[3.00000E+00,4.00000E+00,0.00000E+00]
SET USE_CASCADE=0;
SUCCESS

DROP AND RECREATE A VECTOR TABLE WITH A NEW DIMENSION
DROP TABLE VB;
SUCCESS
CREATE TABLE VB(ID INT, V VECTOR(1));
SUCCESS
DESC VB;
FIELD | TYPE | LENGTH
ID | INTS | 4
V | VECTORS | 1
INSERT INTO VB VALUES(1, STRING_TO_VECTOR('[2.5]'));
SUCCESS
SELECT ID, VECTOR_TO_STRING(V) AS VEC FROM VB;
ID | VEC
1 | [2.50000E+00]
DROP TABLE VB;
SUCCESS
